# DeepSeek API 配置（必填）
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 模型名称（可选，默认 deepseek-chat）
# DeepSeek 模型: deepseek-chat / deepseek-reasoner / deepseek-v4-flash
LLM_MODEL=deepseek-chat

# 数据库路径
DATABASE_URL=sqlite:///./threat_intel.db

# 服务端口
PORT=8000

# 上传目录
UPLOAD_DIR=./uploads
